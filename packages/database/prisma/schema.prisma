generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NoteStatus {
  OPEN
  DONE
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum BusinessMemberType {
  OWNER
  EMPLOYEE
}

enum BusinessMemberStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum ActivityStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum AmountEventType {
  CREATE
  ADD_PAYMENT
  SET_PAID_TOTAL
  SETTLE_BALANCE
  CHANGE_TOTAL
  CORRECTION
  UNDO
}

enum ActionBatchStatus {
  COMPLETED
  PARTIALLY_COMPLETED
  WAITING
  FAILED
  UNDONE
}

enum AssistantResponseMode {
  TEXT_ONLY
  TEXT_AND_VOICE
}

model Business {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  members               BusinessMember[]
  settings              BusinessSettings?
  phoneNumbers          BusinessPhoneNumber[]
  customers             Customer[]
  notes                 Note[]
  IncomingCall          IncomingCall[]
  deviceTokens          DeviceToken[]
  tasks                 Task[]
  jobs                  Job[]
  visits                Visit[]
  customerPhones        CustomerPhone[]
  serviceAddresses      ServiceAddress[]
  amounts               Amount[]
  amountEvents          AmountEvent[]
  actionBatches         ActionBatch[]
  assistantSessions     AssistantSession[]
  apiIdempotencyRecords ApiIdempotencyRecord[]
}

model BusinessSettings {
  id                String   @id @default(uuid())
  businessId        String   @unique
  locale            String   @default("he-IL")
  timezone          String   @default("Asia/Jerusalem")
  greetingText      String?
  reminderPrompt    String?
  urgentPrompt      String?
  workingHours      Json?
  notificationPhone String?
  allowUrgentCalls  Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
}

model User {
  id          String   @id @default(uuid())
  businessId  String?
  email       String?  @unique
  phoneNumber String?  @unique
  displayName String?
  firebaseUid String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business     Business?        @relation(fields: [businessId], references: [id])
  memberships  BusinessMember[]
  deviceTokens DeviceToken[]
  preference   UserPreference?

  @@index([businessId])
  @@index([phoneNumber])
}

model BusinessMember {
  id            String               @id @default(uuid())
  businessId    String
  userId        String?
  phoneNumber   String
  displayName   String?
  memberType    BusinessMemberType   @default(EMPLOYEE)
  status        BusinessMemberStatus @default(PENDING)
  addedByUserId String?
  linkedAt      DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@unique([businessId, phoneNumber])
  @@index([businessId])
  @@index([businessId, status])
  @@index([phoneNumber])
  @@index([userId])
}

model Customer {
  id                   String    @id @default(uuid())
  businessId           String
  name                 String
  email                String?
  deletedAt            DateTime?
  mergedIntoCustomerId String?
  mergedAt             DateTime?
  mergedByUserId       String?
  normalizedName       String?
  generalNotes         String?
  deletedByUserId      String?
  deleteActionBatchId  String?
  version              Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  business         Business         @relation(fields: [businessId], references: [id])
  notes            Note[]
  customerPhones   CustomerPhone[]
  serviceAddresses ServiceAddress[]
  tasks            Task[]
  jobs             Job[]
  visits           Visit[]

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, deletedAt])
  @@index([businessId, mergedIntoCustomerId])
}

model CustomerPhone {
  id                  String    @id @default(uuid())
  businessId          String
  customerId          String
  rawPhone            String
  normalizedPhone     String
  label               String?
  isPrimary           Boolean   @default(false)
  deletedAt           DateTime?
  deletedByUserId     String?
  deleteActionBatchId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([businessId, customerId])
  @@index([businessId, normalizedPhone])
  @@index([businessId, deletedAt])
}

model ServiceAddress {
  id                  String    @id @default(uuid())
  businessId          String
  customerId          String
  label               String?
  addressText         String
  normalizedAddress   String?
  deletedAt           DateTime?
  deletedByUserId     String?
  deleteActionBatchId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  jobs     Job[]
  visits   Visit[]

  @@index([businessId, customerId])
  @@index([businessId, deletedAt])
}

model Task {
  id                  String     @id @default(uuid())
  businessId          String
  customerId          String?
  title               String
  description         String?
  status              TaskStatus @default(OPEN)
  dueAt               DateTime?
  completedAt         DateTime?
  reminderSentAt      DateTime?
  source              String     @default("app")
  sourceRef           String?
  idempotencyKey      String?
  deletedAt           DateTime?
  deletedByUserId     String?
  deleteActionBatchId String?
  version             Int        @default(1)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  business Business  @relation(fields: [businessId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@unique([businessId, idempotencyKey])
  @@index([businessId, customerId])
  @@index([businessId, status, dueAt])
  @@index([businessId, completedAt])
  @@index([businessId, deletedAt])
  @@index([status, dueAt, reminderSentAt])
}

model Job {
  id                         String         @id @default(uuid())
  businessId                 String
  customerId                 String
  title                      String
  description                String?
  startsAt                   DateTime?
  endsAt                     DateTime?
  serviceAddressId           String?
  locationSnapshot           String?
  status                     ActivityStatus @default(OPEN)
  executionCompletedAt       DateTime?
  executionCompletedByUserId String?
  idempotencyKey             String?
  deletedAt                  DateTime?
  deletedByUserId            String?
  deleteActionBatchId        String?
  version                    Int            @default(1)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  business       Business        @relation(fields: [businessId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  serviceAddress ServiceAddress? @relation(fields: [serviceAddressId], references: [id])
  amounts        Amount[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, customerId])
  @@index([businessId, startsAt])
  @@index([businessId, status])
  @@index([businessId, deletedAt])
}

model Visit {
  id                         String         @id @default(uuid())
  businessId                 String
  customerId                 String
  title                      String
  description                String?
  startsAt                   DateTime?
  endsAt                     DateTime?
  serviceAddressId           String?
  locationSnapshot           String?
  status                     ActivityStatus @default(OPEN)
  executionCompletedAt       DateTime?
  executionCompletedByUserId String?
  idempotencyKey             String?
  deletedAt                  DateTime?
  deletedByUserId            String?
  deleteActionBatchId        String?
  version                    Int            @default(1)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  business       Business        @relation(fields: [businessId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  serviceAddress ServiceAddress? @relation(fields: [serviceAddressId], references: [id])
  amounts        Amount[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, customerId])
  @@index([businessId, startsAt])
  @@index([businessId, status])
  @@index([businessId, deletedAt])
}

model Amount {
  id                  String        @id @default(uuid())
  businessId          String
  jobId               String?
  visitId             String?
  totalAmount         Decimal       @db.Decimal(14, 2)
  paidAmount          Decimal       @default(0) @db.Decimal(14, 2)
  currency            String        @default("ILS")
  paymentStatus       PaymentStatus @default(UNPAID)
  deletedAt           DateTime?
  deletedByUserId     String?
  deleteActionBatchId String?
  version             Int           @default(1)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  business Business      @relation(fields: [businessId], references: [id])
  job      Job?          @relation(fields: [jobId], references: [id])
  visit    Visit?        @relation(fields: [visitId], references: [id])
  events   AmountEvent[]

  @@index([businessId, paymentStatus])
  @@index([businessId, jobId])
  @@index([businessId, visitId])
  @@index([businessId, deletedAt])
}

model AmountEvent {
  id            String          @id @default(uuid())
  businessId    String
  amountId      String
  actionBatchId String?
  actorUserId   String
  eventType     AmountEventType
  previousTotal Decimal         @db.Decimal(14, 2)
  nextTotal     Decimal         @db.Decimal(14, 2)
  previousPaid  Decimal         @db.Decimal(14, 2)
  nextPaid      Decimal         @db.Decimal(14, 2)
  paidDelta     Decimal         @db.Decimal(14, 2)
  source        String
  occurredAt    DateTime        @default(now())

  business    Business     @relation(fields: [businessId], references: [id])
  amount      Amount       @relation(fields: [amountId], references: [id])
  actionBatch ActionBatch? @relation(fields: [actionBatchId], references: [id])

  @@index([businessId, occurredAt])
  @@index([amountId, occurredAt])
  @@index([actionBatchId])
}

model Note {
  id         String     @id @default(uuid())
  businessId String
  customerId String
  text       String
  status     NoteStatus @default(OPEN)
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([businessId])
  @@index([businessId, customerId])
  @@index([businessId, status])
  @@index([businessId, deletedAt])
  @@index([businessId, createdAt])
}

model BusinessPhoneNumber {
  id          String   @id @default(uuid())
  businessId  String
  plivoNumber String   @unique
  displayName String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model IncomingCall {
  id            String   @id @default(uuid())
  businessId    String
  plivoCallId   String   @unique
  fromNumber    String?
  toNumber      String
  status        String
  selectedDigit String?
  urgent        Boolean  @default(false)
  recordingUrl  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business    Business         @relation(fields: [businessId], references: [id])
  transcripts CallTranscript[]

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, toNumber])
}

model CallTranscript {
  id             String   @id @default(uuid())
  businessId     String
  incomingCallId String
  transcript     String
  taskId         String?
  provider       String   @default("mock")
  confidence     Decimal?
  createdAt      DateTime @default(now())

  incomingCall IncomingCall @relation(fields: [incomingCallId], references: [id])

  @@index([businessId])
  @@index([incomingCallId])
}

model ActionBatch {
  id                 String            @id @default(uuid())
  businessId         String
  actorUserId        String
  assistantSessionId String?
  voiceCommandId     String?
  approvedTranscript String?
  proposedPlan       Json?
  finalSummary       String
  spokenSummary      String?
  status             ActionBatchStatus
  undoEligibleUntil  DateTime?
  undoneAt           DateTime?
  undoneByUserId     String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  business         Business          @relation(fields: [businessId], references: [id])
  assistantSession AssistantSession? @relation(fields: [assistantSessionId], references: [id])
  steps            ActionBatchStep[]
  mutations        ActionMutation[]
  amountEvents     AmountEvent[]
  assistantTurns   AssistantTurn[]

  @@index([businessId, createdAt])
  @@index([businessId, actorUserId, createdAt])
  @@index([assistantSessionId])
  @@index([voiceCommandId])
}

model ActionBatchStep {
  id            String   @id @default(uuid())
  actionBatchId String
  stepKey       String
  stepType      String
  dependsOn     String[] @default([])
  status        String
  toolName      String?
  input         Json?
  output        Json?
  errorCode     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  actionBatch ActionBatch      @relation(fields: [actionBatchId], references: [id])
  mutations   ActionMutation[]

  @@unique([actionBatchId, stepKey])
  @@index([actionBatchId, createdAt])
}

model ActionMutation {
  id                String   @id @default(uuid())
  actionBatchId     String
  actionBatchStepId String
  sequence          Int
  entityType        String
  entityId          String
  operation         String
  before            Json?
  after             Json?
  createdAt         DateTime @default(now())

  actionBatch     ActionBatch     @relation(fields: [actionBatchId], references: [id])
  actionBatchStep ActionBatchStep @relation(fields: [actionBatchStepId], references: [id])

  @@unique([actionBatchId, sequence])
  @@index([actionBatchStepId])
  @@index([entityType, entityId])
}

model AssistantSession {
  id                    String   @id @default(uuid())
  businessId            String
  userId                String
  clientSessionId       String
  expiresAt             DateTime
  turnCount             Int      @default(0)
  currentCustomerId     String?
  currentEntityType     String?
  currentEntityId       String?
  activePendingActionId String?
  context               Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  business      Business        @relation(fields: [businessId], references: [id])
  turns         AssistantTurn[]
  actionBatches ActionBatch[]

  @@unique([businessId, userId, clientSessionId])
  @@index([businessId, userId, expiresAt])
}

model AssistantTurn {
  id                 String   @id @default(uuid())
  assistantSessionId String
  role               String
  approvedTranscript String?
  actionBatchId      String?
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  assistantSession AssistantSession @relation(fields: [assistantSessionId], references: [id])
  actionBatch      ActionBatch?     @relation(fields: [actionBatchId], references: [id])

  @@index([assistantSessionId, createdAt])
  @@index([expiresAt])
}

model UserPreference {
  id                    String                @id @default(uuid())
  userId                String                @unique
  assistantResponseMode AssistantResponseMode @default(TEXT_ONLY)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model ApiIdempotencyRecord {
  id          String   @id @default(uuid())
  businessId  String
  userId      String
  scope       String
  key         String
  requestHash String
  status      String   @default("PENDING")
  response    Json?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, userId, scope, key])
  @@index([expiresAt])
  @@index([businessId, createdAt])
}

model AiPendingAction {
  id                           String    @id @default(uuid())
  businessId                   String
  userId                       String?
  actionType                   String
  source                       String    @default("ai")
  confidence                   Decimal?
  reviewReason                 String?
  payload                      Json
  missingFields                String[]
  status                       String    @default("PENDING")
  resolution                   Json?
  resolvedAt                   DateTime?
  actionBatchId                String?
  actionBatchStepId            String?
  createdByUserId              String?
  resolvedByUserId             String?
  assistantSessionId           String?
  question                     String?
  candidateEntities            Json?
  entityVersions               Json?
  dependencyStepKeys           String[]  @default([])
  requiresExplicitConfirmation Boolean   @default(false)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([actionBatchId])
  @@index([assistantSessionId])
}

model Notification {
  id            String             @id @default(uuid())
  businessId    String
  itemType      String?
  itemId        String?
  title         String
  body          String
  status        NotificationStatus @default(PENDING)
  payload       Json?
  readAt        DateTime?
  sentAt        DateTime?
  failedAt      DateTime?
  failureReason String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([businessId, itemType, itemId])
}

model DeviceToken {
  id         String   @id @default(uuid())
  businessId String
  userId     String
  token      String   @unique
  platform   String?
  appVersion String?
  status     String   @default("ACTIVE")
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([businessId, status])
  @@index([userId])
}

model AuditEvent {
  id         String   @id @default(uuid())
  businessId String
  actorType  String
  actorId    String?
  source     String
  entityType String
  entityId   String?
  action     String
  before     Json?
  after      Json?
  result     String
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([businessId, createdAt])
}

model UsageEvent {
  id         String   @id @default(uuid())
  businessId String
  provider   String
  metric     String
  quantity   Decimal
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([businessId])
}
