{
  "name": "myclient-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MyClient server-side POC monorepo",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "tsc -b tsconfig.json",
    "lint": "eslint services packages scripts",
    "format": "prettier --write services packages scripts package.json tsconfig*.json",
    "test:unit:core": "tsx --test 'packages/common/src/**/*.test.ts' 'services/core/src/**/*.test.ts'",
    "test:unit:ai": "tsx --test 'services/ai/src/**/*.test.ts'",
    "test:unit": "npm run test:unit:core && npm run test:unit:ai",
    "dev:core": "npm run dev -w @myclient/core",
    "dev:ai": "npm run dev -w @myclient/ai",
    "dev:voice": "npm run dev -w @myclient/voice",
    "dev:telephony": "npm run dev -w @myclient/telephony",
    "dev:worker": "npm run dev -w @myclient/worker",
    "seed:demo": "node scripts/seed-demo.mjs",
    "test:integration": "node scripts/integration-tests.mjs",
    "prisma:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema packages/database/prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@prisma/client": "6.12.0",
    "fastify": "5.12.1",
    "firebase-admin": "^14.3.0",
    "google-auth-library": "^11.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prisma": "6.12.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "fastify": "$fastify"
  },
  "engines": {
    "node": ">=24"
  }
}
