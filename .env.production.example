NODE_ENV=production
DEFAULT_LOCALE=he-IL

AUTH_PROVIDER=firebase

MOCK_LLM_PROVIDER=false
MOCK_STT_PROVIDER=false
MOCK_TTS_PROVIDER=false
MOCK_PLIVO_PROVIDER=false
MOCK_FCM_PROVIDER=false

WORKER_REMINDER_POLL_ENABLED=true
WORKER_REMINDER_POLL_INTERVAL_MS=30000
WORKER_REMINDER_BATCH_SIZE=20

OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_LLM_MODEL=gpt-5-mini

CORE_BASE_URL=<set-during-deployment>
AI_BASE_URL=<set-during-deployment>
VOICE_BASE_URL=<set-during-deployment>
