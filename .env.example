NODE_ENV=development
DATABASE_URL=postgresql://myclient:myclient@localhost:5432/myclient?schema=public

CORE_PORT=3000
AI_PORT=3001
VOICE_PORT=3002
TELEPHONY_PORT=3003
WORKER_PORT=3004

CORE_BASE_URL=http://localhost:3000
AI_BASE_URL=http://localhost:3001
VOICE_BASE_URL=http://localhost:3002
DEFAULT_LOCALE=he-IL
INTERNAL_API_SECRET=dev-internal-secret

MOCK_LLM_PROVIDER=false
MOCK_STT_PROVIDER=false
MOCK_TTS_PROVIDER=true
MOCK_PLIVO_PROVIDER=true
MOCK_FCM_PROVIDER=true

OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_LLM_MODEL=gpt-5-mini
